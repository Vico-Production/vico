# Developer-only fallback for API keys. The app itself stores keys in the system
# credential store (Settings > Cloud processing). Never commit a real .env file.
VICO_GROQ_API_KEY=
VICO_GEMINI_API_KEY=

# Optional: where Vico keeps its database, logs and browser profile
# VICO_DATA_DIR=

# Optional: run the desktop shell against a specific Python (development)
# VICO_PYTHON=

# Browser-only UI development (npm run dev without Tauri). Start a sidecar with a
# token you choose, then set these. Not used by the desktop app.
# VITE_SIDECAR_URL=http://127.0.0.1:<port>
# VITE_SIDECAR_TOKEN=<the same token>
