{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vico",
  "version": "0.1.0",
  "identifier": "com.vico.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vico",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false,
        "label": "aura",
        "focus": false,
        "width": 1280,
        "height": 800
      },
      {
        "title": "Vico",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false,
        "label": "prompt",
        "width": 460,
        "height": 138
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A multilingual agent that operates your computer",
    "longDescription": "Summon Vico with Win+Alt+V, then speak or type in English, Yoruba, Hausa or Igbo, and it does it on your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "template": "./windows/installer.nsi",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libportaudio2",
          "xdotool",
          "wmctrl",
          "gstreamer1.0-plugins-good"
        ]
      },
      "rpm": {
        "depends": [
          "portaudio",
          "xdotool",
          "wmctrl",
          "gstreamer1-plugins-good"
        ]
      }
    }
  }
}
