{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vico",
  "version": "0.1.0",
  "identifier": "com.vico.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vico",
        "width": 1100,
        "height": 780,
        "minWidth": 420,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Multilingual voice assistant for your computer",
    "longDescription": "Speak or type in English, Yoruba, Hausa or Igbo and Vico acts on your computer with your approval, or interprets a conversation.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "linux": {
      "deb": { "depends": ["libportaudio2", "xdotool", "wmctrl"] }
    }
  }
}
